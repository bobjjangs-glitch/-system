{
  "name": "daejeon-dispatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=24.3 <25"
  },
  "scripts": {
    "start": "expo start --max-workers 2",
    "web": "expo start --web --max-workers 2",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start:go": "expo start --go --max-workers 2",
    "server": "node --use-env-proxy --experimental-strip-types server/index.ts",
    "server:dev": "node --use-env-proxy --watch --experimental-strip-types server/index.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "node --experimental-strip-types --test --test-concurrency=1 server/tests/*.test.ts",
    "export:mobile": "expo export --platform android --platform ios --max-workers 2",
    "export:web": "expo export --platform web --max-workers 2"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/kor": "1.0.0",
    "cors": "^2.8.5",
    "exceljs": "4.4.0",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-location": "~57.0.22",
    "expo-notifications": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "express": "5.3.0",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "leaflet": "^1.9.4",
    "lucide-react-native": "^0.577.0",
    "multer": "^2.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "tesseract.js": "7.0.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "~19.2.2",
    "@types/ws": "^8.18.1",
    "typescript": "~6.0.3"
  }
}
