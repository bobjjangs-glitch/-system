# 휴대폰에서 접근 가능한 HTTPS 서버 주소. 웹을 서버에서 함께 제공할 때는 생략 가능.
EXPO_PUBLIC_API_URL=
# 서버의 영구 데이터 디렉터리. 클라우드 설치/시작 스킬이 저장소 밖으로 지정합니다.
APP_DATA_DIR=.local
PORT=4000
# 선택: 네이버 서버 인증이 없을 때 사용할 카카오 주소 검색 키.
KAKAO_REST_API_KEY=
# 선택: 관리자 네이버 웹 지도 Key ID. 관리자 지도 설정에 저장한 값이 우선합니다.
NAVER_MAPS_KEY_ID=
# 배포 시 허용할 웹앱 출처(쉼표로 구분). 로컬 개발에서는 생략 가능.
CORS_ORIGINS=
# 로컬 Nginx 뒤에서 HOST=127.0.0.1로 실행할 때 loopback 사용.
TRUST_PROXY=
# 선택: 최초 관리자 등록을 보호하는 일회성 등록 코드. 값은 환경 설정에서 입력.
DISPATCH_BOOTSTRAP_TOKEN=
# 선택: 서버 실시간 교통 배차용 Naver Cloud Maps Directions 15 인증 정보.
# 두 값 모두 필요합니다. Key Secret은 EXPO_PUBLIC_* 또는 앱 설정에 넣지 마세요.
NAVER_DIRECTIONS_KEY_ID=
NAVER_DIRECTIONS_KEY_SECRET=
# 선택: 주소 검색 전용 네이버 인증. 생략하면 위 Directions 인증을 재사용합니다.
# 해당 Naver Application에서 Geocoding을 활성화해야 합니다. 공개 지도 Key ID만으로는 부족합니다.
NAVER_GEOCODING_KEY_ID=
NAVER_GEOCODING_KEY_SECRET=
