{
  "cli": { "version": "26.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "ldplayer": {
      "extends": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bareun-dispatch-test.onrender.com"
      },
      "android": {
        "gradleCommand": ":app:assembleRelease -PreactNativeArchitectures=x86_64"
      }
    },
    "internal": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    }
  }
}
