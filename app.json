{
  "expo": {
    "name": "바른배차",
    "slug": "bareun-dispatch",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "bareundispatch",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bobjjang.bareundispatch",
      "infoPlist": {
        "UIBackgroundModes": ["location"],
        "LSApplicationQueriesSchemes": ["kakaomap", "nmap"]
      }
    },
    "android": {
      "package": "com.bobjjang.bareundispatch",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#153b36"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "배송 중 현재 위치를 관리자에게 공유하고 다음 배송지 길안내에 사용합니다.",
          "locationAlwaysAndWhenInUsePermission": "길안내 앱을 사용하는 동안에도 배송 위치를 관리자에게 공유합니다.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "인쇄 전표 사진을 업로드합니다.",
          "cameraPermission": "배송 전표를 촬영합니다.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "backgroundColor": "#153b36",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#153b36"
          }
        }
      ]
    ],
    "icon": "./assets/icon.png"
  }
}
